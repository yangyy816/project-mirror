  "components": {
    "schemas": {
      "AccessTokenResponse": {
        "properties": {
          "access_token": {
            "type": "string",
            "title": "Access Token"
          },
          "token_type": {
            "type": "string",
            "const": "Bearer",
            "title": "Token Type",
            "default": "Bearer"
          },
          "scope": {
            "type": "string",
            "enum": [
              "pending",
              "active"
            ],
            "title": "Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "access_token",
          "scope"
        ],
        "title": "AccessTokenResponse"
      },
      "AgeAssuranceRequest": {
        "properties": {
          "credential": {
            "type": "string",
            "maxLength": 4096,
            "minLength": 1,
            "format": "password",
            "title": "Credential",
            "writeOnly": true
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "credential"
        ],
        "title": "AgeAssuranceRequest"
      },
      "AgeAssuranceResponse": {
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "Record Id"
          },
          "result": {
            "type": "string",
            "enum": [
              "verified",
              "not_verified",
              "indeterminate"
            ],
            "title": "Result"
          },
          "activated": {
            "type": "boolean",
            "title": "Activated"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "record_id",
          "result",
          "activated"
        ],
        "title": "AgeAssuranceResponse"
      },
      "CurrentUserResponse": {
        "properties": {
          "user_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$",
            "title": "User Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "active"
            ],
            "title": "Status"
          },
          "scope": {
            "type": "string",
            "enum": [
              "pending",
              "active"
            ],
            "title": "Scope"
          },
          "onboarding_requirements": {
            "items": {
              "type": "string",
              "enum": [
                "age_assurance",
                "policy_acceptance"
              ]
            },
            "type": "array",
            "title": "Onboarding Requirements"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "user_id",
          "status",
          "scope",
          "onboarding_requirements"
        ],
        "title": "CurrentUserResponse"
      },
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorEnvelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "ready",
              "limited"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mirror-api"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
