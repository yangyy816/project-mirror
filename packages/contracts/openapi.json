            "title": "Self State Version Id",
            "type": "string"
          },
          "question_bank_version": {
            "title": "Question Bank Version",
            "type": "string"
          },
          "routing_algorithm_version": {
            "title": "Routing Algorithm Version",
            "type": "string"
          },
          "route_seed": {
            "title": "Route Seed",
            "type": "string"
          },
          "measurement_normalization_version": {
            "title": "Measurement Normalization Version",
            "type": "string"
          },
          "morphology_descriptor_version": {
            "title": "Morphology Descriptor Version",
            "type": "string"
