  "components": {
    "schemas": {
      "ErrorEnvelope": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "details": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "items": {},
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorEnvelope"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "live",
              "ready",
              "limited"
            ],
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mirror-api"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "dependencies": {
            "additionalProperties": {
              "type": "string",
              "enum": [
                "available",
                "unavailable",
                "not_checked"
              ]
            },
            "type": "object",
            "title": "Dependencies"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "dependencies"
        ],
        "title": "HealthResponse"
      },
      "PlaceholderRequest": {
        "properties": {
          "intent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Intent"
          }
        },
        "type": "object",
        "title": "PlaceholderRequest"
      },
      "Settings": {
        "properties": {
          "app_env": {
            "type": "string",
            "enum": [
              "development",
              "test",
              "ci",
              "production"
            ],
            "title": "App Env",
            "default": "development"
          },
          "app_version": {
            "type": "string",
            "title": "App Version",
            "default": "0.1.0"
          },
          "log_level": {
            "type": "string",
            "title": "Log Level",
            "default": "INFO"
          },
          "debug": {
            "type": "boolean",
            "title": "Debug",
            "default": false
          },
          "database_url": {
            "type": "string",
            "title": "Database Url",
            "default": "postgresql+psycopg://mirror:mirror_dev_only@127.0.0.1:5432/mirror"
          },
          "redis_url": {
            "type": "string",
            "title": "Redis Url",
            "default": "redis://127.0.0.1:6379/0"
          },
          "cors_origins": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Cors Origins"
          },
          "auth_token_secret": {
            "type": "string",
            "title": "Auth Token Secret",
            "default": "development-only-not-for-production"
          },
          "auth_callback_url": {
            "type": "string",
            "title": "Auth Callback Url",
            "default": "http://127.0.0.1:3000/auth/callback"
          },
          "sms_provider": {
            "type": "string",
            "enum": [
              "mock",
              "tencent"
            ],
            "title": "Sms Provider",
            "default": "mock"
          },
          "storage_provider": {
            "type": "string",
            "enum": [
              "local",
              "tencent_cos"
            ],
            "title": "Storage Provider",
            "default": "local"
          },
          "local_storage_root": {
            "type": "string",
            "format": "path",
            "title": "Local Storage Root",
            "default": ".local-storage"
          },
          "object_storage_private": {
            "type": "boolean",
            "title": "Object Storage Private",
            "default": true
          },
          "signed_url_ttl_seconds": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 60.0,
            "title": "Signed Url Ttl Seconds",
            "default": 300
          },
          "vision_provider": {
            "type": "string",
            "enum": [
              "mock",
              "disabled",
              "verified_external",
              "tencent_candidate"
            ],
            "title": "Vision Provider",
            "default": "mock"
          },
          "image_generation_provider": {
            "type": "string",
            "enum": [
              "mock",
              "disabled",
              "verified_external",
              "tencent_candidate"
            ],
            "title": "Image Generation Provider",
            "default": "mock"
          },
          "agent_provider": {
            "type": "string",
            "enum": [
              "mock",
              "disabled",
              "verified_external",
              "tencent_candidate"
            ],
            "title": "Agent Provider",
            "default": "mock"
          },
          "task_runner": {
            "type": "string",
            "enum": [
              "local",
              "celery"
            ],
            "title": "Task Runner",
            "default": "local"
          },
          "sensitive_processing_enabled": {
            "type": "boolean",
            "title": "Sensitive Processing Enabled",
            "default": false
          },
          "legal_review_status": {
            "type": "string",
            "enum": [
              "required",
              "approved"
            ],
            "title": "Legal Review Status",
            "default": "required"
          },
          "provider_benchmark_status": {
            "type": "string",
            "enum": [
              "required",
              "approved"
            ],
            "title": "Provider Benchmark Status",
            "default": "required"
          },
          "tencent_secret_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tencent Secret Id"
          },
          "tencent_secret_key": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tencent Secret Key"
          },
          "tencent_region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tencent Region"
          },
          "tencent_cos_bucket": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tencent Cos Bucket"
          },
          "tencent_sms_app_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tencent Sms App Id"
          },
          "tencent_sms_sign_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tencent Sms Sign Name"
          }
        },
        "type": "object",
        "title": "Settings"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VersionResponse": {
        "properties": {
          "service": {
            "type": "string",
            "title": "Service",
            "default": "mirror-api"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "api_version": {
            "type": "string",
            "title": "Api Version",
            "default": "v1"
          }
        },
        "type": "object",
        "required": [
          "version"
        ],
        "title": "VersionResponse"
      },
      "SelfStateContract": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "exclusiveMinimum": 0,
            "title": "Version",
            "type": "integer"
          },
          "baseline_face_model_id": {
            "title": "Baseline Face Model Id",
            "type": "string"
          },
          "state_schema_version": {
            "title": "State Schema Version",
            "type": "string"
          },
          "reliable_dimensions": {
            "items": {
              "type": "string"
            },
            "title": "Reliable Dimensions",
            "type": "array"
          },
          "unreliable_dimensions": {
            "items": {
              "type": "string"
            },
            "title": "Unreliable Dimensions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "version",
          "baseline_face_model_id",
          "state_schema_version",
          "reliable_dimensions",
          "unreliable_dimensions"
        ],
        "title": "SelfStateContract",
        "type": "object"
      },
      "DesiredDeltaDimensionContract": {
        "additionalProperties": false,
        "properties": {
          "dimension_key": {
            "title": "Dimension Key",
            "type": "string"
          },
          "direction": {
            "enum": [
              -1,
              0,
              1
            ],
            "title": "Direction",
            "type": "integer"
          },
          "magnitude": {
            "minimum": 0,
            "title": "Magnitude",
            "type": "number"
          },
          "preference_confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Preference Confidence",
            "type": "number"
          },
          "generalization_confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Generalization Confidence",
            "type": "number"
          },
          "transfer_confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Transfer Confidence",
            "type": "number"
          },
          "user_lock": {
            "enum": [
              "none",
              "preserve"
            ],
            "title": "User Lock",
            "type": "string"
          }
        },
        "required": [
          "dimension_key",
          "direction",
          "magnitude",
          "preference_confidence",
          "generalization_confidence",
          "transfer_confidence",
          "user_lock"
        ],
        "title": "DesiredDeltaDimensionContract",
        "type": "object"
      },
      "DesiredDeltaProfileContract": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "title": "Id",
            "type": "string"
          },
          "version": {
            "exclusiveMinimum": 0,
            "title": "Version",
            "type": "integer"
          },
          "self_state_version_id": {
            "title": "Self State Version Id",
            "type": "string"
          },
          "inference_algorithm_version": {
            "title": "Inference Algorithm Version",
            "type": "string"
          },
          "evidence_fusion_version": {
            "title": "Evidence Fusion Version",
            "type": "string"
          },
          "dimensions": {
            "items": {
              "$ref": "#/components/schemas/DesiredDeltaDimensionContract"
            },
            "title": "Dimensions",
            "type": "array"
          }
        },
        "required": [
          "id",
          "version",
          "self_state_version_id",
          "inference_algorithm_version",
          "evidence_fusion_version",
          "dimensions"
        ],
        "title": "DesiredDeltaProfileContract",
        "type": "object"
      },
      "QuestionnaireRunContextContract": {
        "additionalProperties": false,
        "properties": {
          "baseline_face_model_id": {
            "title": "Baseline Face Model Id",
