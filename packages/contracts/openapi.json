            "title": "Neighborhood Metric Version",
            "type": "string"
          },
          "stimulus_generator_version": {
            "title": "Stimulus Generator Version",
            "type": "string"
          }
        },
        "required": [
          "baseline_face_model_id",
          "self_state_version_id",
          "question_bank_version",
          "routing_algorithm_version",
          "route_seed",
