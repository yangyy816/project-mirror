# Shared
APP_ENV=development
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# Web
API_BASE_URL=http://127.0.0.1:8000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# API / Worker
DATABASE_URL=postgresql+psycopg://mirror:mirror_dev_only@127.0.0.1:5432/mirror
REDIS_URL=redis://127.0.0.1:6379/0
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DEBUG=false
AUTH_TOKEN_SECRET=development-only-not-for-production
AUTH_CALLBACK_URL=http://127.0.0.1:3000/auth/callback
AUTH_REQUIRED_POLICIES=[]
SMS_PROVIDER=mock
STORAGE_PROVIDER=local
LOCAL_STORAGE_ROOT=.local-storage
OBJECT_STORAGE_PRIVATE=true
SIGNED_URL_TTL_SECONDS=300
VISION_PROVIDER=mock
IMAGE_GENERATION_PROVIDER=mock
AGENT_PROVIDER=mock
TASK_RUNNER=local
SENSITIVE_PROCESSING_ENABLED=false
LEGAL_REVIEW_STATUS=required
PROVIDER_BENCHMARK_STATUS=required

# Tencent Cloud credentials belong only in an untracked .env or secret manager.
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_REGION=
TENCENT_COS_BUCKET=
TENCENT_SMS_APP_ID=
TENCENT_SMS_SIGN_NAME=
